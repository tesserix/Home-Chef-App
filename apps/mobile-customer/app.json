            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.tesserix.homechef.customer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF385C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "homechef-customer"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fe3dr.com",
              "pathPrefix": "/chef"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fe3dr.com",
              "pathPrefix": "/group"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Fe3dr uses your location to show kitchens that deliver to you and to work out the delivery distance.",
          "locationWhenInUsePermission": "Fe3dr uses your location to show kitchens that deliver to you and to work out the delivery distance.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.849928263410-cv5p1hdpt7ftkg0t1l8fmjhjhd8aq5rp"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "18.0",
            "newArchEnabled": true,
            "buildReactNativeFromSource": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fe3dr uses your photo library so you can attach a photo to an order issue report.",
          "cameraPermission": "Fe3dr uses your camera so you can take a photo for an order issue report."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "mode": "production",
          "icon": "./assets/notification-icon.png",
          "color": "#FF385C",
          "defaultChannel": "order-updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF385C"
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/259c48bf-fb51-4f93-8fdc-7149aa15f881",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.2",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "259c48bf-fb51-4f93-8fdc-7149aa15f881"
      }
    },
