# @tesserix packages come from GitHub Packages. This mapping is load-bearing:
# without it pnpm resolves the scope against registry.npmjs.org, which carries a
# DIFFERENT subset of versions and no /download/<sha> tarball — so the lockfile
# records a URL CI then 404s on. Every @tesserix entry in pnpm-lock.yaml resolves
# to npm.pkg.github.com/download/...; keep it that way.
@tesserix:registry=https://npm.pkg.github.com

# React Native + new architecture codegen scans node_modules/ flat. pnpm's
# default symlinked layout breaks codegen discovery of native modules
# (react-native-gesture-handler, etc.). Use hoisted layout to mirror npm
# behaviour. Required for `expo run:ios` / `xcodebuild` to find codegen
# headers in apps/mobile-*/ios/build/generated/.
node-linker=hoisted
